model MedicalReport {
  id         String @id @default(uuid(7))
  patientId  String
  reportName String
  reportLink String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  patient Patient @relation(fields: [patientId], references: [id])

  @@index([patientId])
  @@map("medical_reports")
}
